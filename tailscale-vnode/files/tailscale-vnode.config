
config globals 'globals'
	# Private link network between the host and the node namespaces. Each node
	# keeps one /30 of it for as long as it exists. It never leaves the router: traffic
	# is NATed on both sides of the veth pair. It must not be link-local
	# (169.254.0.0/16): tailscaled would consider the namespace offline.
	# The default is TEST-NET-2, which no real network uses.
	option subnet '198.51.100.0/24'
	# First UDP port handed to a node's tailscaled when the node sets none.
	option base_port '41642'
	# Let peers on the router's upstream network connect to the nodes
	# directly: each node's UDP port is forwarded to it and advertised.
	# Off by default, as it opens those ports on the WAN side.
	option inbound '0'
	# Cloudflare DNS: an A record (DNS only) per node pointing at its
	# Tailscale address. Names default to <Tailscale name>.<dns_suffix>; a
	# node can set its own with dns_name, or opt out with dns '0'. The API
	# token (an account API token is recommended; Zone DNS edit plus zone
	# read) is kept in
	# /etc/tailscale-vnode/cloudflare.token, not here.
	option dns_enabled '0'
	option dns_suffix ''
	# Let the router's dnsmasq return these 100.x answers to LAN clients
	# despite rebind protection (runtime snippet, /etc/config/dhcp unchanged).
	option dns_rebind '1'

# One section per virtual node. Everything that reaches the node's Tailscale
# address is forwarded to target, on every port and protocol.
#
#config node 'desktop'
#	option enabled '1'
#	option target '192.168.1.100'
#	option hostname 'desktop'
#	list tag 'tag:vnode'
#	option port ''
#	option extra_args ''
#	option dns '1'
#	option dns_name ''
#	# How the node is drawn in LuCI: desktop, laptop, server or phone.
#	option icon ''
